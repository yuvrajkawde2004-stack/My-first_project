*{box-sizing:border-box;margin:0;padding:0;font-family:Inter,Arial,sans-serif}body{background:#f3f6fb;color:#172033}.navbar{background:linear-gradient(135deg,#111827,#2563eb);color:white;padding:18px 7%;display:flex;justify-content:space-between;align-items:center;box-shadow:0 8px 25px rgba(0,0,0,.15)}.brand{font-size:24px;font-weight:800}.nav-links{display:flex;gap:18px;align-items:center}.nav-links a{color:white;text-decoration:none;font-weight:600}.logout{background:#ef4444;padding:9px 14px;border-radius:12px}.container{width:90%;max-width:1250px;margin:30px auto}.alert{padding:14px 18px;border-radius:14px;margin-bottom:18px;font-weight:700}.success{background:#dcfce7;color:#166534}.danger{background:#fee2e2;color:#991b1b}.login-page{min-height:75vh;display:flex;justify-content:center;align-items:center}.login-card,.form-card{background:white;border-radius:26px;padding:35px;box-shadow:0 18px 50px rgba(20,40,90,.12)}.login-card{width:420px}.login-card h1,.form-card h1,.hero h1{font-size:34px;margin-bottom:10px}.login-card p,.hero p{color:#64748b;margin-bottom:22px}label{display:block;margin:13px 0 8px;font-weight:700}input{width:100%;padding:14px 15px;border:1px solid #dbe3ef;border-radius:14px;font-size:15px;background:#f8fafc}button,.primary-btn{border:0;background:linear-gradient(135deg,#2563eb,#0ea5e9);color:white;padding:14px 22px;border-radius:14px;font-weight:800;text-decoration:none;cursor:pointer;box-shadow:0 10px 25px rgba(37,99,235,.25)}.login-card button{width:100%;margin:18px 0}.hero{display:flex;justify-content:space-between;align-items:center;background:white;border-radius:26px;padding:30px;margin-bottom:24px;box-shadow:0 15px 40px rgba(20,40,90,.08)}.stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:18px;margin-bottom:28px}.stat-card{background:white;border-radius:22px;padding:24px;box-shadow:0 12px 35px rgba(20,40,90,.08);border-left:6px solid #2563eb}.stat-card span{color:#64748b;font-weight:800}.stat-card h2{margin-top:12px;font-size:28px}.stat-card.danger{border-left-color:#ef4444;background:white;color:#172033}.stat-card.success{border-left-color:#22c55e;background:white;color:#172033}.section-title{display:flex;justify-content:space-between;align-items:center;margin:24px 0 15px}.section-title a{font-weight:800;color:#2563eb}.table-wrap{background:white;border-radius:24px;overflow:auto;box-shadow:0 15px 40px rgba(20,40,90,.08)}table{width:100%;border-collapse:collapse;min-width:980px}th{background:#eff6ff;color:#1e3a8a;text-align:left;padding:15px}td{padding:14px;border-bottom:1px solid #e5e7eb;color:#334155}.badge{padding:7px 11px;border-radius:999px;font-weight:800;font-size:12px}.paid{background:#dcfce7;color:#166534}.pending{background:#fef3c7;color:#92400e}.actions{display:flex;gap:10px}.actions a,.delete{font-weight:800;text-decoration:none;color:#2563eb}.delete{color:#ef4444}.empty{text-align:center;color:#64748b;padding:22px}.grid-form{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}.grid-form button,.wide{grid-column:1/-1}.cards-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}.mini-card{background:white;border-radius:18px;padding:18px;box-shadow:0 12px 30px rgba(20,40,90,.08);display:flex;flex-direction:column;gap:8px}small{color:#64748b}@media(max-width:720px){.navbar,.hero{flex-direction:column;gap:16px;align-items:flex-start}.nav-links{flex-wrap:wrap}.grid-form{grid-template-columns:1fr}.login-card{width:100%}.container{width:94%}}
